{"seed_id": "spider__chinook_1__00826", "db_id": "chinook_1", "db_path": "data\\spider_data\\spider_data\\database\\chinook_1\\chinook_1.sqlite", "question": "What is the name of the artist with the greatest number of albums?", "gold_sql": "SELECT T2.Name FROM ALBUM AS T1 JOIN ARTIST AS T2 ON T1.ArtistId  =  T2.ArtistId GROUP BY T2.Name ORDER BY COUNT(*) DESC LIMIT 1", "tables": ["ALBUM", "ARTIST"], "join_keys": ["ALBUM.ArtistId=ARTIST.ArtistId"], "joins": [{"left_table": "ALBUM", "left_col": "ArtistId", "right_table": "ARTIST", "right_col": "ArtistId"}], "join_key_columns": {"ALBUM": ["ArtistId"], "ARTIST": ["ArtistId"]}, "key_columns": ["ALBUM.ArtistId", "ARTIST.ArtistId", "ARTIST.Name"], "key_columns_by_table": {"ALBUM": ["ArtistId"], "ARTIST": ["ArtistId", "Name"]}, "key_column_types": {"ALBUM.ArtistId": "INTEGER", "ARTIST.ArtistId": "INTEGER", "ARTIST.Name": "VARCHAR"}, "result_shape": {"rows": 1, "cols": 1}}
{"seed_id": "spider__driving_school__06688", "db_id": "driving_school", "db_path": "data\\spider_data\\spider_data\\database\\driving_school\\driving_school.sqlite", "question": "Which city does has most number of customers?", "gold_sql": "SELECT T2.city FROM Customers AS T1 JOIN Addresses AS T2 ON T1.customer_address_id = T2.address_id GROUP BY T2.city ORDER BY count(*) DESC LIMIT 1;", "tables": ["Customers", "Addresses"], "join_keys": ["Customers.customer_address_id=Addresses.address_id"], "joins": [{"left_table": "Customers", "left_col": "customer_address_id", "right_table": "Addresses", "right_col": "address_id"}], "join_key_columns": {"Customers": ["customer_address_id"], "Addresses": ["address_id"]}, "key_columns": ["Addresses.address_id", "Addresses.city", "Customers.customer_address_id"], "key_columns_by_table": {"Customers": ["customer_address_id"], "Addresses": ["address_id", "city"]}, "key_column_types": {"Customers.customer_address_id": "INTEGER", "Addresses.address_id": "INTEGER", "Addresses.city": "VARCHAR"}, "result_shape": {"rows": 1, "cols": 1}}
{"seed_id": "spider__insurance_fnol__00909", "db_id": "insurance_fnol", "db_path": "data\\spider_data\\spider_data\\database\\insurance_fnol\\insurance_fnol.sqlite", "question": "What is the name of the customer who has the most policies listed?", "gold_sql": "SELECT t1.customer_name FROM customers AS t1 JOIN customers_policies AS t2 ON t1.customer_id  =  t2.customer_id GROUP BY t1.customer_name ORDER BY count(*) DESC LIMIT 1", "tables": ["customers", "customers_policies"], "join_keys": ["customers.customer_id=customers_policies.customer_id"], "joins": [{"left_table": "customers", "left_col": "customer_id", "right_table": "customers_policies", "right_col": "customer_id"}], "join_key_columns": {"customers": ["customer_id"], "customers_policies": ["customer_id"]}, "key_columns": ["customers.customer_id", "customers.customer_name", "customers_policies.customer_id"], "key_columns_by_table": {"customers": ["customer_id", "customer_name"], "customers_policies": ["customer_id"]}, "key_column_types": {"customers.customer_id": "TEXT", "customers.customer_name": "TEXT", "customers_policies.customer_id": "TEXT"}, "result_shape": {"rows": 1, "cols": 1}}
{"seed_id": "spider__journal_committee__00663", "db_id": "journal_committee", "db_path": "data\\spider_data\\spider_data\\database\\journal_committee\\journal_committee.sqlite", "question": "Show the names of editors that are on at least two journal committees.", "gold_sql": "SELECT T1.Name FROM editor AS T1 JOIN journal_committee AS T2 ON T1.Editor_ID  =  T2.Editor_ID GROUP BY T1.Name HAVING COUNT(*)  >=  2", "tables": ["editor", "journal_committee"], "join_keys": ["editor.Editor_ID=journal_committee.Editor_ID"], "joins": [{"left_table": "editor", "left_col": "Editor_ID", "right_table": "journal_committee", "right_col": "Editor_ID"}], "join_key_columns": {"editor": ["Editor_ID"], "journal_committee": ["Editor_ID"]}, "key_columns": ["editor.Editor_ID", "editor.Name", "journal_committee.Editor_ID"], "key_columns_by_table": {"editor": ["Editor_ID", "Name"], "journal_committee": ["Editor_ID"]}, "key_column_types": {"editor.Editor_ID": "INT", "editor.Name": "TEXT", "journal_committee.Editor_ID": "INT"}, "result_shape": {"rows": 1, "cols": 1}}
